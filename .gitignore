# Local-only working notes — NEVER commit. Contains machine-specific paths
# and session context, not project documentation.
PROGRESS.md
.scratch/

__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
*.db
# ...but test fixtures are source, not user data. Without this the OpenCode
# fixture is silently untracked: tests pass on the machine that generated it and
# fail on CI, which is the worst possible split.
!tests/fixtures/**/*.db
*.db-wal
*.db-shm
.DS_Store
macos/**/xcuserdata/
macos/**/.build/
macos/build/
*.app/

# Generated from macos/make-icon.swift — the .icns is committed, the staging
# directory it is built from is not.
macos/burn-o-meter.iconset/
